{
  "name": "fbt-combos-server",
  "private": true,
  "version": "0.1.0",
  "description": "Frame Beat Trainer online combo library API (Cloudflare Workers + D1)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p .",
    "db:init:local": "wrangler d1 execute fbt-combos --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute fbt-combos --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.100.0"
  }
}
